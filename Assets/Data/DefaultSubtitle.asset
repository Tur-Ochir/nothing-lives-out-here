MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f7f6e1c03ca41038dc1666523689649, type: 3}
  m_Name: DefaultSubtitle
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDatabase
  subtitles:
  - id: intro
    english: Tester testing the test in test and testers will test tester
    mongolian: "\u0428\u0430\u043B\u0433\u0430\u0433\u0447 \u0448\u0430\u043B\u0433\u0443\u0443\u0440\u044B\u0433
      \u0448\u0430\u043B\u0433\u0430\u0436 \u0431\u0430\u0439\u043D\u0430. \u0428\u0430\u043B\u0433\u0430\u0433\u0447
      \u043D\u0430\u0440 \u0448\u0430\u043B\u0433\u0430\u043D\u0430 \u0448\u0430\u043B\u0433\u0430\u0433\u0447
      \u043D\u0430\u0440\u044B\u0433"
    duration: 6
  - id: close-door
    english: I need to close door.
    mongolian: "\u0425\u0430\u0430\u043B\u0433\u0430\u0430 \u0445\u0430\u0430\u0445
      \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439."
    duration: 6
  - id: light
    english: The light will probably be turned on by the battery next to the chest.
    mongolian: "\u0410\u0432\u0434\u0430\u0440\u043D\u044B \u0445\u0430\u0436\u0443\u0443\u0434
      \u0431\u0430\u0439\u0433\u0430\u0430 \u0430\u043A\u0435\u043C\u043B\u0430\u0442\u0440\u0430\u0430\u0440
      \u0433\u044D\u0440\u043B\u0438\u0439\u043D \u0430\u0441\u0430\u0430\u0445 \u0431\u0430\u0439\u0445."
    duration: 6
  - id: argal
    english: I'm freezing. Collect dumbs and fire furnace.
    mongolian: "\u0425\u04E9\u043B\u0434\u04E9\u0436 \u04AF\u0445\u044D\u0445\u043D\u044D\u044D.
      \u0410\u0440\u0433\u0430\u043B \u0442\u04AF\u04AF\u0436 \u0433\u0430\u043B
      \u0430\u0441\u0430\u0430\u044F."
    duration: 6
  - id: tsogts
    english: I need a match.
    mongolian: "\u0428\u04AF\u0434\u044D\u043D\u0437 \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439."
    duration: 3
  - id: locked-door
    english: Door is locked.
    mongolian: "\u0425\u0430\u0430\u043B\u0433\u0430 \u0446\u043E\u043E\u0436\u0442\u043E\u0439
      \u0431\u0430\u0439\u043D\u0430."
    duration: 4
  - id: arag
    english: It's easy to collect using an Arag.
    mongolian: "\u0410\u0440\u0430\u0433 \u0430\u0448\u0438\u0433\u043B\u0430\u0436
      \u0442\u04AF\u04AF\u0432\u044D\u043B \u0430\u043C\u0430\u0440 \u0431\u0430\u0439\u043D\u0430."
    duration: 4
  - id: arag-full
    english: It's full.
    mongolian: "\u0410\u0440\u0430\u0433 \u0434\u04AF\u04AF\u0440\u0436\u044D\u044D."
    duration: 2
  - id: match
    english: Match need to start a fire.
    mongolian: "\u0413\u0430\u043B \u0430\u0441\u0430\u0430\u0445\u0430\u0434 \u0448\u04AF\u0434\u044D\u043D\u0446
      \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439."
    duration: 3.5
  - id: fire
    english: It's getting warm, and now I'm starting to get hungry.
    mongolian: "\u0414\u0443\u043B\u0430\u0430\u0445\u0430\u043D \u0431\u043E\u043B\u0447\u0438\u0445\u043B\u043E\u043E,
      \u041E\u0434\u043E\u043E \u04E9\u043B\u0441\u04E9\u0436 \u044D\u0445\u043B\u044D\u0436
      \u0431\u0430\u0439\u043D\u0430 \u0448\u04AF\u04AF."
    duration: 4
  - id: not-bed-time
    english: It's not time for bed yet.
    mongolian: "\u0443\u043D\u0442\u0430\u0445 \u0446\u0430\u0433 \u0430\u0440\u0430\u0439
      \u0431\u043E\u043B\u043E\u043E\u0433\u04AF\u0439 \u0431\u0430\u0439\u043D\u0430."
    duration: 4
  - id: eat-fill
    english: Whoo my stomach is so full, I start to feel sleepy.
    mongolian: "\u0413\u044D\u0434\u044D\u0441 \u0434\u04AF\u04AF\u0440\u0447\u0438\u0445\u0441\u044D\u043D
      \u0447\u0438\u043D\u044C \u043D\u043E\u0439\u0440 \u0445\u04AF\u0440\u044D\u044D\u0434
      \u044D\u0445\u043B\u044D\u043B\u044D\u044D \u0431\u0430\u0439\u043D\u0430."
    duration: 4
  - id: raw-warning
    english: If you take the lid off now, the dumplings will be raw.
    mongolian: "\u041E\u0434\u043E\u043E \u0442\u0430\u0433\u0438\u0439\u043D \u0430\u0432\u0447\u0438\u0445\u0432\u0430\u043B
      \u0431\u0443\u0443\u0437 \u0442\u04AF\u04AF\u0445\u0438\u0439\u0440\u043D\u044D."
    duration: 4
  - id: min-req-dumplings
    english: I can't get enough of these few dumplings.
    mongolian: "\u0418\u0439\u043C \u0446\u04E9\u04E9\u0445\u04E9\u043D \u0431\u0443\u0443\u0437
      \u0438\u0434\u044D\u044D\u0434 \u0446\u0430\u0434\u0430\u0445\u0433\u04AF\u0439."
    duration: 4
