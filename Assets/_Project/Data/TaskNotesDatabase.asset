  m_Notes:
  - m_Id: f9a572f8-a1fe-4eb9-a368-130fec2ad323
    m_Title: Story
    m_Content: "\u041C\u0430\u043B\u0430\u0430 \u0445\u0430\u0440\u0438\u0443\u043B\u0436
      \u044F\u0432\u0430\u0430\u0434 \u0448\u0443\u0443\u0440\u0433\u0430\u043D\u0434
      \u04E9\u0440\u0442\u04E9\u04E9\u0434 \u0442\u04E9\u04E9\u0440\u0441\u04E9\u043D.
      \u0410\u0440\u0430\u0439 \u0433\u044D\u0436 \u043D\u044D\u0433 \u0433\u044D\u0440
      \u043E\u043B\u043E\u043E\u0434 \u043E\u0440\u0436 \u0438\u0440\u0441\u044D\u043D.
      (\u0445\u0430\u0440\u0438\u0443\u043B\u0436 \u0431\u0430\u0439\u0433\u0430\u0430
      \u0445\u043E\u043D\u044C, \u0443\u043D\u0430\u0436 \u0431\u0430\u0439\u0433\u0430\u0430
      \u043C\u043E\u0440\u044C?)\n\u0425\u044D\u0440\u0432\u044D\u044D \u0431\u0430\u0440\u0438\u0433\u0434\u0441\u0430\u043D
      \u0445\u04AF\u043D \u043D\u0430\u0439\u0437 \u043E\u0445\u0438\u043D \u043D\u044C
      \u0431\u043E\u043B - \u0428\u0443\u0443\u0440\u0433\u0430\u043D\u0434 \u0442\u04E9\u04E9\u0440\u04E9\u04E9\u0434
      \u043C\u0430\u0448\u0438\u043D \u043D\u044C \u0433\u0430\u0446\u0441\u0430\u043D
      \u043D\u0430\u0439\u0437 \u043E\u0445\u0438\u043D\u043E\u043E \u043C\u0430\u0448\u0438\u043D\u0434\u0430\u0430
      \u04AF\u043B\u0434\u044D\u044D\u0433\u044D\u044D\u0434 \u0442\u0443\u0441\u043B\u0430\u043C\u0436
      \u043E\u043B\u043E\u0445\u043E\u043E\u0440 \u044F\u0432\u043D\u0430.\n\n-\u0413\u044D\u0440
      \u043E\u043B\u043D\u043E\r\n- \u0413\u044D\u0440\u044D\u043B \u0430\u0441\u0430\u0430\u0445\r\n-
      \u0410\u0440\u0433\u0430\u043B \u0442\u04AF\u04AF\u0445\r\n- \u0413\u0430\u043B
      \u0430\u0441\u0430\u0430\u0445\n\u04E8\u043B\u0441\u0441\u04E9\u043D \u0442\u0443\u043B
      \u0445\u04E9\u043B\u0434\u04E9\u04E9\u0433\u0447\u0438\u0439\u043D \u043E\u043D\u0433\u043E\u0439\u043B\u0433\u043E\u0436
      \u04AF\u0437\u043D\u044D. \u042D\u0432\u0433\u04AF\u0439 \u044E\u0443\u043D\u044B\u0445
      \u043D\u044C \u043C\u044D\u0434\u044D\u0433\u0434\u044D\u0445\u0433\u04AF\u0439
      \u044F\u0441 \u043C\u0430\u0445 \u0431\u0430\u0439\u043D\u0430.\r\n- \u0411\u0443\u0443\u0437
      \u0447\u0430\u043D\u0430\u0445\n- \u0420\u0430\u0434\u0438\u043E \u0442\u0430\u0430\u0440\u0443\u0443\u043B\u0430\u0436
      \u043C\u044D\u0434\u044D\u044D \u0441\u043E\u043D\u0441\u043E\u0445\n\u041C\u044D\u0434\u044D\u044D\u0433\u044D\u044D\u0440
      \u0448\u0443\u0443\u0440\u0433\u0430 \u043C\u0430\u0440\u0433\u0430\u0430\u0448
      \u0431\u043E\u043B\u0442\u043E\u043B \u0437\u043E\u0433\u0441\u043E\u0445\u0433\u04AF\u0439
      \u0433\u044D\u043D\u044D. \u0425\u04AF\u043D \u0430\u043B\u0433\u0430 \u0431\u043E\u043B\u0441\u043E\u043D
      \u0442\u0430\u043B\u0430\u0430\u0440 \u043C\u044D\u0434\u044D\u044D\u043B\u044D\u043B\u043D\u044D.\n-\u0411\u0443\u0443\u0437
      \u0438\u0434\u044D\u0445\r\n- \u0423\u043D\u0442\u0430\u0445\r\n\r\n\u0413\u044D\u043D\u044D\u0442
      \u0445\u0430\u0448\u0438\u0440\u0433\u0430\u0430\u043D\u044B \u0447\u0438\u043C\u044D\u044D\u043D\u044D\u044D\u0440
      \u0446\u043E\u0447\u0438\u0436 \u0441\u044D\u0440\u044D\u0445. \r\n\u0425\u043E\u043B\u043E\u043E\u0441
      \u0445\u04AF\u043D\u0438\u0439 \u0438\u0440\u0436 \u0431\u0430\u0439\u0433\u0430\u0430
      \u0447\u0438\u043C\u044D\u044D \u0433\u0430\u0440\u0430\u0445. (\u0443\u0439\u043B\u0430\u0436
      \u0431\u0430\u0439\u0433\u0430\u0430?)\n\r\n- \u041D\u0443\u0443\u0433\u0434\u0430\u0445\r\n\u041D\u0443\u0443\u0433\u0434\u0430\u0430\u0433\u04AF\u0439
      \u0431\u0430\u0439\u0445\u0430\u0434 \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u043E\u0440\u043E\u043E\u0434 \u0438\u0440\u0432\u044D\u043B\u2192 **Bad Ending**\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u0433\u044D\u0440\u0442 \u0431\u0430\u0439\u0445\u0430\u0434 \u043D\u0443\u0443\u0433\u0434\u0430\u0445\u0430\u0430
      \u0431\u043E\u043B\u0438\u0432\u043E\u043B\u2192 **Bad Ending** \r\n\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u0445\u04AF\u043D \u0447\u0438\u0440\u0446\u044D\u043D \u043E\u0440\u0436
      \u0438\u0440\u043D\u044D.  (\u041D\u0430\u0439\u0437 \u043E\u0445\u0438\u043D
      \u043D\u044C \u0431\u0430\u0439\u0436 \u0431\u043E\u043B\u043D\u043E?)\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u0445\u04AF\u043D\u0438\u0439 \u0445\u04E9\u043B\u0438\u0439\u043D \u0442\u0430\u0441\u0434\u0430\u043D\u0430.
      \u0425\u043E\u043E\u043B\u043D\u044B \u043C\u0430\u0445 \u0431\u044D\u043B\u0434\u044D\u043D\u044D.
      \u0425\u04E9\u0440\u0433\u04E9\u0433\u0447\u0438\u043D\u0434 \u0445\u0438\u0439\u043D\u044D.\n\u042D\u043D\u044D
      \u0445\u044D\u0441\u044D\u0433\u0442 \u0447\u0438\u043C\u044D\u044D\u0433\u04AF\u0439
      \u0431\u0430\u0439\u0445 \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439 -Voice
      detection\n\u0427\u0438\u043C\u044D\u044D \u0433\u0430\u0440\u0433\u0430\u0432\u0430\u043B\u2192
      **Bad Ending**\n\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D \u0430\u0440\u0433\u0430\u043B
      \u0442\u04AF\u04AF\u0445\u044D\u044D\u0440 \u0433\u0430\u0440\u0430\u0430\u0434
      \u044F\u0432\u043D\u0430.\n\u0410\u0440\u0430\u0430\u0441 \u043D\u044C \u0433\u0430\u0440\u0432\u0430\u043B\u2192
      **Bad Ending**\n\n-\u0425\u04E9\u043B\u04E9\u04E9 \u0442\u0430\u0441\u0434\u0443\u0443\u043B\u0441\u0430\u043D
      \u0445\u04AF\u043D\u0438\u0439\u0433 checkleh \u0430\u043C\u044C\u0434 \u0431\u0430\u0439\u043D\u0430
      \u043D\u0430\u0434\u0430\u0434 \u0442\u0443\u0441\u043B\u0430\u0430\u0447 \u0433\u044D\u043D\u044D.
      \u041C\u0430\u0448\u0438\u043D \u043D\u044C \u0431\u0430\u0439\u0433\u0430\u0430
      \u0433\u044D\u043D\u044D. \u0413\u044D\u0445\u0434\u044D\u044D \u0442\u04AF\u043B\u0445\u04AF\u04AF\u0440
      \u043D\u044C \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D\u0434 \u0431\u0430\u0439\u0433\u0430\u0430.\n\n*\u0417\u044D\u0432\u0441\u044D\u0433
      \u043E\u043B\u043E\u0445\n-\u0410\u0432\u0434\u0430\u0440 \u043E\u043D\u0433\u043E\u0439\u043B\u0433\u043E\u0436
      \u0431\u0443\u0443 \u0430\u0432\u0430\u0445 (puzzle?)\n-\u0417\u0430\u0430\u0437\u0443\u0443\u0440\u044B\u043D
      \u0430\u0432\u0430\u0445\n\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u0431\u0443\u0446\u0430\u0436 \u043E\u0440\u0436 \u0438\u0440\u043D\u044D.
      \n-\u0411\u0443\u0443\u0442\u0430\u0439 \u0431\u043E\u043B \u0431\u0443\u0443\u0434\u0430\u0436
      \u0443\u043D\u0430\u0433\u0430\u0430\u0436 \u0447\u0430\u0434\u043D\u0430.\n-melee
      weapon-\u0442\u044D\u0439 \u0431\u043E\u043B \u0442\u0443\u043B\u0430\u043B\u0434\u0430\u043D\u0430.
      (Very hard)\n\u042D\u0441\u0432\u044D\u043B \u043D\u0443\u0443\u0433\u0434\u0430\u0430\u0434
      \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D\u0433 \u0443\u043D\u0442\u0430\u0445\u044B\u0433
      \u0445\u04AF\u043B\u044D\u044D\u043D\u044D.\n\n\u041C\u0430\u0448\u0438\u043D\u0438\u0439
      \u0442\u04AF\u043B\u0445\u04AF\u04AF\u0440 \u0430\u0432\u043D\u0430.\n-\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D\u0433
      \u0443\u043D\u0430\u0433\u0430\u0430\u0433\u04AF\u0439 \u04AF\u0435\u0434 \u0445\u04AF\u043D\u0438\u0439\u0433
      \u0430\u0432\u0440\u0430\u0445 \u0433\u044D\u0436 \u043E\u0440\u043E\u043B\u0434\u0432\u043E\u043B
      \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D \u0441\u044D\u0440\u043D\u044D,
      \u0431\u0430\u0440\u0438\u0433\u0434\u0430\u043D\u0430. \u2192**Grey Ending**\n-\u0425\u04AF\u043D\u0438\u0439\u0433
      \u0430\u0432\u0440\u0430\u0445\u0433\u04AF\u0439 \u0437\u0443\u0433\u0442\u0430\u0445
      \u2192**Grey Ending** (\u0437\u0443\u0433\u0442\u0430\u0436 \u0447\u0430\u0434\u043D\u0430.
      \u043C\u044D\u0434\u044D\u044D\u0433\u044D\u044D\u0440 \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D\u0433
      \u0431\u0430\u0440\u044C\u0441\u0430\u043D \u0433\u044D\u0445\u0434\u044D\u044D
      \u0445\u04AF\u043D \u04AF\u0445\u0441\u044D\u043D\u0433 \u043E\u043B\u043E\u0432
      \u0433\u044D\u043D\u044D. )\n\n\u0410\u043B\u0443\u0443\u0440\u0447\u0438\u043D\u0433
      \u0443\u043D\u0433\u0430\u0430\u0433\u0430\u0430\u0434 \u0445\u04AF\u043D\u044D\u044D
      \u0430\u0432\u0440\u0430\u0430\u0434 \u0437\u0443\u0433\u0442\u0430\u0445\u2192**Good
      Ending**\n-\u042F\u0433 \u0437\u0443\u0433\u0442\u0430\u0445 \u0433\u044D\u0436
      \u0431\u0430\u0439\u0445\u0430\u0434 \u0430\u043B\u0443\u0443\u0440\u0447\u0438\u043D
      \u0430\u0440\u0430\u0430\u0441 \u0445\u04AF\u0440\u044D\u044D\u0434 \u0438\u0440\u043D\u044D.
      \n-Last battle"
